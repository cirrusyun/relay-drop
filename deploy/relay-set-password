#!/bin/sh
set -eu

relay_script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
relay_project_dir="$(dirname -- "$relay_script_dir")"
relay_env_file="${RELAY_ENV_FILE:-$relay_project_dir/.env}"

restore_terminal() {
  stty echo 2>/dev/null || true
  unset relay_password_one relay_password_two
}

trap restore_terminal EXIT HUP INT TERM

if [ ! -t 0 ]; then
  echo "请通过带终端的 SSH 连接运行此命令。" >&2
  exit 1
fi

printf '请输入新密码（至少 8 个字符，输入不会显示）：'
stty -echo
IFS= read -r relay_password_one
printf '\n请再次输入新密码：'
IFS= read -r relay_password_two
printf '\n'
stty echo

if [ "$relay_password_one" != "$relay_password_two" ]; then
  echo "两次输入不一致，密码没有修改。" >&2
  exit 1
fi

if [ "${#relay_password_one}" -lt 8 ]; then
  echo "密码少于 8 个字符，密码没有修改。" >&2
  exit 1
fi

relay_hash="$(printf '%s\n' "$relay_password_one" | docker run --rm -i caddy:2.11.4-alpine caddy hash-password --algorithm argon2id)"

case "$relay_hash" in
  '$argon2id$'*) ;;
  *)
    echo "无法生成有效的 Argon2id 哈希，密码没有修改。" >&2
    exit 1
    ;;
esac

unset relay_password_one relay_password_two

RELAY_NEW_HASH="$relay_hash" python3 - "$relay_env_file" <<'PY'
import os
import pathlib
import tempfile

env_path = pathlib.Path(__import__("sys").argv[1])
new_hash = os.environ["RELAY_NEW_HASH"]
lines = env_path.read_text(encoding="utf-8").splitlines()
replacement = f"AUTH_PASSWORD_HASH='{new_hash}'"
updated = []
replaced = False

for line in lines:
    if line.startswith("AUTH_PASSWORD_HASH="):
        updated.append(replacement)
        replaced = True
    else:
        updated.append(line)

if not replaced:
    raise SystemExit(f"AUTH_PASSWORD_HASH is missing from {env_path}")

file_descriptor, temporary_name = tempfile.mkstemp(prefix=".env.", dir=env_path.parent)
try:
    os.fchmod(file_descriptor, 0o600)
    with os.fdopen(file_descriptor, "w", encoding="utf-8") as temporary:
        temporary.write("\n".join(updated) + "\n")
        temporary.flush()
        os.fsync(temporary.fileno())
    os.replace(temporary_name, env_path)
finally:
    try:
        os.unlink(temporary_name)
    except FileNotFoundError:
        pass
PY

unset relay_hash RELAY_NEW_HASH
cd "$relay_project_dir"
docker compose up -d --force-recreate caddy >/dev/null
sleep 2
docker compose ps --status running caddy --quiet | grep -q .

trap - EXIT HUP INT TERM
echo "密码已修改，新密码现在可以登录。"
